<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MacHands.app/Contents/Info.plist 的模板。

  SwiftPM 不产出 .app,所以 scripts/build-app.sh 把 .build/release/MacHands 拷进
  MacHands.app/Contents/MacOS/,把这份文件拷进 Contents/,再用自己的参数覆写
  身份与版本键 —— bundle 里写的东西不可能和实际构建的不一致。

  关键键,以及为什么:

    LSUIElement                  没有 Dock 图标、不进 ⌘-Tab:它只活在菜单栏。
    CFBundleIdentifier           SMAppService 注册登录项用的身份,也是 codesign
                                 盖进去的标识。
    LSMinimumSystemVersion       13.0:SMAppService.mainApp 要 macOS 13+。
    NSUserNotificationsUsageDescription
                                 审批卡与配对成功都会发通知(SPEC §7.3 / §4.2)。
    NSAppleEventsUsageDescription
                                 `run` 里如果 agent 跑了 osascript,系统会以本 App
                                 的名义要 Apple Events 权限;没有这条字符串,弹窗
                                 是空白的,用户不知道谁在要什么。
    NSAppTransportSecurity       中继默认是明文 `ws://134.199.230.126:8443`。
                                 内容本身是端到端加密的(铁律 2),TLS 只是外壳;
                                 但 ATS 默认禁止明文,不加例外 URLSession 连试都不试。
                                 地址是用户可改的运行时值,没法按域名声明例外。
                                 想去掉这条:给中继上证书并改用 wss://。

  屏幕录制没有 Info.plist 键 —— TCC 认的是**进程**。第一次截屏时用
  CGRequestScreenCaptureAccess() 触发系统弹窗(SPEC §7.4)。
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>                  <string>MacHands</string>
  <key>CFBundleDisplayName</key>           <string>MacHands</string>
  <key>CFBundleExecutable</key>            <string>MacHands</string>
  <key>CFBundleIdentifier</key>            <string>app.machands.MacHands</string>
  <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>
  <key>CFBundlePackageType</key>           <string>APPL</string>
  <key>CFBundleSignature</key>             <string>????</string>
  <key>CFBundleIconFile</key>              <string>AppIcon</string>
  <key>CFBundleShortVersionString</key>    <string>0.2.0</string>
  <key>CFBundleVersion</key>               <string>20</string>
  <key>LSMinimumSystemVersion</key>        <string>13.0</string>
  <key>LSApplicationCategoryType</key>     <string>public.app-category.developer-tools</string>
  <key>LSUIElement</key>                   <true/>
  <key>NSPrincipalClass</key>              <string>NSApplication</string>
  <key>NSHighResolutionCapable</key>       <true/>
  <key>NSSupportsSuddenTermination</key>   <false/>
  <key>NSHumanReadableCopyright</key>      <string>MacHands. Distributed as-is, no warranty.</string>
  <key>CFBundleDevelopmentRegion</key>     <string>zh-Hans</string>
  <key>NSUserNotificationsUsageDescription</key>
  <string>MacHands 会在 agent 请求执行命令、以及有新 agent 接入时通知你。</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>agent 请求执行的命令可能会驱动其它 App(例如 osascript)。每一条都会先问过你。</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>      <true/>
  </dict>
  <key>CFBundleLocalizations</key>
  <array>
    <string>zh-Hans</string>
    <string>en</string>
  </array>
</dict>
</plist>
