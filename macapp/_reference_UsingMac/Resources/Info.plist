<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for UsingMac.app/Contents/Info.plist.

  SwiftPM does not build .app bundles, so scripts/build-app.sh copies the
  executable from .build/release/UsingMac into UsingMac.app/Contents/MacOS/ and
  this file into UsingMac.app/Contents/, then overwrites the identity and
  version keys from its own flags so the bundle can never disagree with what
  was actually built.

  Keys that matter, and why:

    LSUIElement                  no Dock icon, no ⌘-Tab entry: it lives in the
                                 menu bar and nowhere else.
    CFBundleIdentifier           the identity SMAppService registers as a login
                                 item, and the identifier codesign stamps in.
    CFBundleShortVersionString   the marketing version (1.0) — what a human
    CFBundleVersion              reads; the build number (monotonic) — what the
                                 notary service and Sparkle-style updaters
                                 compare. Notarisation wants both present and
                                 distinct in purpose.
    LSMinimumSystemVersion       13.0: SMAppService.mainApp is macOS 13+.
    NSHumanReadableCopyright     shown in Finder's Get Info; the notary service
                                 flags bundles with no copyright string.

  Deliberately ABSENT — usage-description strings:

    NSAppleEventsUsageDescription  would be required if this app drove other
      apps through AppleScript / Apple Events. It does not: everything it does
      is `ssh`, files under ~/.ssh and ~/Library, and one NSWorkspace.open of
      the Sharing settings pane. Adding a usage string for a permission the app
      never asks for makes the first-run dialogs *less* honest, not more.

    Screen recording (what `mac shot` needs on the far side) is granted through
      TCC to *sshd*, not to this app, and TCC has no Info.plist key to declare
      it. This app never captures the screen itself.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>                  <string>UsingMac</string>
  <key>CFBundleDisplayName</key>           <string>Using Mac</string>
  <key>CFBundleExecutable</key>            <string>UsingMac</string>
  <key>CFBundleIdentifier</key>            <string>com.using-mac.menubar</string>
  <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>
  <key>CFBundlePackageType</key>           <string>APPL</string>
  <key>CFBundleSignature</key>             <string>????</string>
  <key>CFBundleIconFile</key>              <string>AppIcon</string>
  <!-- marketing version and build number: separate on purpose (see above) -->
  <key>CFBundleShortVersionString</key>    <string>1.0</string>
  <key>CFBundleVersion</key>               <string>1</string>
  <key>LSMinimumSystemVersion</key>        <string>13.0</string>
  <key>LSApplicationCategoryType</key>     <string>public.app-category.utilities</string>
  <key>LSUIElement</key>                   <true/>
  <key>NSPrincipalClass</key>              <string>NSApplication</string>
  <key>NSHighResolutionCapable</key>       <true/>
  <key>NSSupportsSuddenTermination</key>   <false/>
  <key>NSHumanReadableCopyright</key>      <string>using-mac. Distributed as-is, no warranty.</string>
  <key>CFBundleDevelopmentRegion</key>     <string>en</string>
  <!-- App Transport Security 例外。
       为什么需要:登记端点是**用户在设置窗口里自己填的服务器**上的明文 HTTP
       (http://<你的服务器>:8765/enroll)。ATS 默认禁止明文请求,不加例外的话
       URLSession 会直接失败并报「requires the use of a secure connection」——
       请求根本发不出这台 Mac,与服务器是否可达无关。
       域名无法预先声明(服务器地址是运行时输入的),所以只能用全局例外。
       这条例外只影响本 app 自己发起的请求;它不会放宽系统里其它任何东西。
       走的到底是什么内容:一次 POST,内容只有公钥 + 一次性配对码,**没有私钥**。
       残余风险与缓解见 SECURITY.md(单次使用 / 30 天过期 / 拿到手只能绑一个反向端口)。
       想彻底去掉这条例外:给登记端点上 TLS,或把登记改走 SSH 通道。 -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>      <true/>
  </dict>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
  </array>
</dict>
</plist>
