# 复制成 /etc/machands/store.env,填好,然后 chmod 600。
# 这个文件里全是占位符,真密钥永远不要提交进仓库。
#
#   sudo mkdir -p /etc/machands
#   sudo cp tools/store/store.env.example /etc/machands/store.env
#   sudo chmod 600 /etc/machands/store.env && sudo chown root:root /etc/machands/store.env
#   sudo nano /etc/machands/store.env

# ---- 服务本身 ----------------------------------------------------------
STORE_PORT=8790
STORE_HOST=127.0.0.1
# 订单落在哪儿。备份的时候就备份这个目录。
STORE_DIR=/opt/machands/store
# 签发私钥。丢了就签不出新证,务必离线备份一份。
LICENSE_KEY_FILE=/root/.machands-license/key.json
# 邮件里给买家的下载地址。绑好域名后改成 https://你的域名
SITE_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN

# ---- 收款渠道 · 只填你真正用的那一家,其它留空 ---------------------------
# 留空 = 那个渠道的 webhook 直接 404。空 secret 绝不会变成"谁都能发单"。

# Lemon Squeezy:后台 Settings → Webhooks 里那个 Signing secret
LS_WEBHOOK_SECRET=

# Paddle(Billing):后台 Developer tools → Notifications 里那条 destination 的 secret key
# 形如 pdl_ntfset_…
PADDLE_WEBHOOK_SECRET=

# Creem:后台 Developers → Webhooks 里的 signing secret
CREEM_WEBHOOK_SECRET=

# ---- 发信 --------------------------------------------------------------
# none = 不发信,只落盘,自己用 admin.mjs 补发(先这么开也行,不影响收钱)
# resend = 走 Resend 的 API;smtp = 自己的邮箱服务器
MAIL_BACKEND=none

# 发件人,必须是你验证过的域名下的地址
MAIL_FROM=MacHands <hello@REPLACE_WITH_YOUR_DOMAIN>

# MAIL_BACKEND=resend 时要这个
RESEND_API_KEY=

# MAIL_BACKEND=smtp 时要这些
SMTP_HOST=
SMTP_PORT=587
# 端口 465 或把这个设成 implicit 就走隐式 TLS;587 会自动 STARTTLS
SMTP_TLS=
SMTP_USER=
SMTP_PASS=
SMTP_EHLO=machands.local
